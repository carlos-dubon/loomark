# Pin a release, or leave as latest to always take the newest.
LOOMARK_VERSION="latest"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# The origin you reach loomark on. Must match exactly, scheme included.
AUTH_URL="http://localhost:3000"

# Set to false once your account exists to close sign ups.
ALLOW_REGISTRATION="true"

# Host port loomark is published on.
APP_PORT="3000"

# Database credentials. Changing these after first start needs a new volume.
POSTGRES_USER="loomark"
POSTGRES_PASSWORD="loomark"
POSTGRES_DB="loomark"

# Only used when running outside Docker.
# DATABASE_URL="postgresql://loomark:loomark@localhost:5432/loomark?schema=public"
