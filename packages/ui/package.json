  "description": "Shared Loomark UI components.",
  "homepage": "https://github.com/carlos-dubon/loomark#readme",
  "bugs": {
    "url": "https://github.com/carlos-dubon/loomark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlos-dubon/loomark.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "author": "Carlos Daniel Dubón <holacarlosdubon@gmail.com>",
  "private": true,
